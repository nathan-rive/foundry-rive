<Rive version="1" kind="fragment">
    <!-- Progress clock (Blades in the Dark style): a pie that fills one segment at a time.
         Data: segments (any whole number, usually 4, 6 or 8), filled, color, label, tick.
         No scripts, so local builds run on web runtimes too.
         - The fill is one thick stroke with a TrimPath whose end is filled / segments, eased.
         - The dividers are one dashed thick stroke whose gap is 1 / segments, so any
           segment count works without one shape per segment.
         - The clock pops when filled changes, and when tick fires. -->
    <Artboard viewModelId="0:40" viewModelInstanceId="0:46" defaultStateMachineId="0:7" styleId="0:5"
              width="400" height="460" name="Clock" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Node x="200" y="200" name="Clock" id="0:10">
            <!-- First declared paints on top. -->
            <Shape name="Flash" id="0:15" opacity="0">
                <Ellipse width="330" height="330" name="Path"/>
                <Stroke thickness="10" name="Stroke">
                    <SolidColor colorValue="FFFFF2C8" name="Color"/>
                </Stroke>
            </Shape>

            <Shape name="Hub">
                <Ellipse width="26" height="26" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF1A1512" name="Color"/></Fill>
            </Shape>

            <Shape name="Rim">
                <Ellipse width="330" height="330" name="Path"/>
                <Stroke thickness="12" name="Stroke">
                    <SolidColor colorValue="FF1A1512" name="Color"/>
                </Stroke>
            </Shape>
            <Shape name="Rim Highlight">
                <Ellipse width="344" height="344" name="Path"/>
                <Stroke thickness="3" name="Stroke">
                    <SolidColor colorValue="FF7A6650" name="Color"/>
                </Stroke>
            </Shape>

            <!-- Dividers: a pie-thick stroke, dashed: a thin dash at every segment boundary. -->
            <Shape name="Dividers">
                <Ellipse width="162" height="162" name="Path"/>
                <Stroke thickness="162" name="Stroke">
                    <SolidColor colorValue="FF1A1512" name="Color"/>
                    <DashPath offsetIsPercentage="true" offset="-0.0045" name="Dashes">
                        <Dash lengthIsPercentage="true" length="0.009" name="Divider"/>
                        <Dash lengthIsPercentage="true" length="0.1547" name="Gap">
                            <DataBindContext sourcePathIds="0:40-0:41" propertyKey="692" converterId="0:53"/>
                        </Dash>
                    </DashPath>
                </Stroke>
            </Shape>

            <!-- The filled part: a pie-thick stroke trimmed to filled / segments. -->
            <Shape name="Filled">
                <Ellipse width="162" height="162" name="Path"/>
                <Stroke thickness="162" name="Stroke">
                    <SolidColor colorValue="FFC8452D" name="Color">
                        <DataBindContext sourcePathIds="0:40-0:43" propertyKey="37"/>
                    </SolidColor>
                    <TrimPath start="0" end="0.3333" name="Progress">
                        <DataBindContext sourcePathIds="0:40-0:42" propertyKey="115" converterId="0:52"/>
                    </TrimPath>
                </Stroke>
            </Shape>

            <Shape name="Empty">
                <Ellipse width="324" height="324" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF3B332B" name="Color"/></Fill>
            </Shape>
            <Shape name="Face">
                <Ellipse width="344" height="344" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FF2A2420" name="Color"/></Fill>
            </Shape>
        </Node>

        <Text x="200" y="420" sizingValue="fixed" width="380" height="64" originX="0.5" originY="0.5"
              alignValue="center" verticalAlignValue="middle" overflowValue="fitFontSize" wrapValue="noWrap"
              name="Label">
            <TextStylePaint fontSize="40" fontAssetId="0:30" name="Label Style" id="0:31">
                <Fill name="Fill"><SolidColor colorValue="FFE8D9B5" name="Color"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:31" text="Clock" name="Label Run">
                <DataBindContext sourcePathIds="0:40-0:44" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <StateMachine name="Clock" id="0:7">
            <StateMachineLayer name="Pop" id="0:8">
                <AnyState x="0" y="-120">
                    <StateTransition stateToId="0:13">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:45" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:13">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="686" converterId="0:54"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="400" y="-120"/>
                <EntryState x="-200" y="0">
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="0" y="0" animationId="0:60" id="0:12"/>
                <AnimationState x="200" y="0" animationId="0:61" reset="true" id="0:13">
                    <StateTransition stateToId="0:12" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation loopValue="oneShot" duration="1" name="Idle" id="0:60">
            <KeyedObject objectId="0:10">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="1" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" interpolationType="linear"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <LinearAnimation loopValue="oneShot" duration="24" name="Pop" id="0:61">
            <KeyedObject objectId="0:10">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                    <KeyFrameDouble value="1.08" interpolationType="linear" frame="6"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="24"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                    <KeyFrameDouble value="1.08" interpolationType="linear" frame="6"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="24"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:15">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.9" interpolationType="linear" frame="4"/>
                    <KeyFrameDouble value="0" interpolationType="linear" frame="24"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <FontAsset file="fonts/IMFellEnglish-Regular.ttf" name="IM Fell English" id="0:30"/>

    <!-- min(1, max(0, filled / max(1, segments))) -->
    <DataConverterFormula name="Filled fraction" id="0:50">
        <FormulaTokenFunction functionType="0"/>
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenFunction functionType="1"/>
        <FormulaTokenValue operationValue="0"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenInput/>
        <FormulaTokenOperation operationType="3"/>
        <FormulaTokenFunction functionType="1"/>
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenValue>
            <DataBindContext sourcePathIds="0:40-0:41" propertyKey="777"/>
        </FormulaTokenValue>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenParenthesisClose/>
    </DataConverterFormula>
    <DataConverterInterpolator interpolationType="linear" duration="0.35" name="Ease" id="0:51"/>
    <DataConverterGroup name="Filled to trim" id="0:52">
        <DataConverterGroupItem converterId="0:50"/>
        <DataConverterGroupItem converterId="0:51"/>
    </DataConverterGroup>

    <!-- The gap between dividers: 1 / max(1, segments) - divider width. -->
    <DataConverterFormula name="Divider gap" id="0:53">
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenOperation operationType="3"/>
        <FormulaTokenFunction functionType="1"/>
        <FormulaTokenValue operationValue="1"/>
        <FormulaTokenArgumentSeparator/>
        <FormulaTokenInput/>
        <FormulaTokenParenthesisClose/>
        <FormulaTokenOperation operationType="1"/>
        <FormulaTokenValue operationValue="0.009"/>
    </DataConverterFormula>

    <DataConverterTrigger name="Filled changed" id="0:54"/>

    <ViewModel defaultInstanceId="0:46" name="ProgressClock" id="0:40">
        <ViewModelPropertyNumber name="segments" id="0:41"/>
        <ViewModelPropertyNumber name="filled" id="0:42"/>
        <ViewModelPropertyColor name="color" id="0:43"/>
        <ViewModelPropertyString name="label" id="0:44"/>
        <ViewModelPropertyTrigger name="tick" id="0:45"/>
        <ViewModelInstance exports="true" name="Default" id="0:46">
            <ViewModelInstanceNumber propertyValue="6" viewModelPropertyId="0:41"/>
            <ViewModelInstanceNumber propertyValue="2" viewModelPropertyId="0:42"/>
            <ViewModelInstanceColor propertyValue="FFC8452D" viewModelPropertyId="0:43"/>
            <ViewModelInstanceString propertyValue="Clock" viewModelPropertyId="0:44"/>
            <ViewModelInstanceTrigger viewModelPropertyId="0:45"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
