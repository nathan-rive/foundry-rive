anceBoolean propertyValue="false" viewModelPropertyId="0:43" id="0:28217"/><ViewModelInstanceString propertyValue="The Ward of the Seventh Star&#10;&#10;Whosoever reads these words aloud beneath an open sky shall be shielded from the gaze of the night until the coming of the dawn.&#10;&#10;Let the reader stand within a circle of salt, face the north, and speak the seven names in turn. With each name a star shall kindle above; when all seven burn, the ward is sealed.&#10;&#10;Break the circle, and the ward breaks with it." viewModelPropertyId="0:44" id="0:28218"/></ViewModelInstance></ViewModel><FontAsset file="fonts/IMFellEnglish-Regular.ttf" name="IM Fell English" id="0:70"/><DataConverterBooleanNegate name="Not" id="0:90"/></Rive>
